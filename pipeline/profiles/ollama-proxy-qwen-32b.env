# =============================================================================
# Profile: ollama-proxy-qwen-32b   (SINGLE-MODEL — qwen2.5:32b on every attempt)
# UNIFORM profile: the same base/instruct model on all 4 attempts. No size ramp.
# See ollama-proxy-qwen-7b.env for the GPU-thrash rationale behind uniform
# profiles (one model loaded ⇒ parallel requests batch instead of evicting).
#
#   1-4: qwen2.5:32b   (Qwen2.5 base/instruct, 32.8B, 32k ctx)
#
# HEAVY: at 32k context the 32B rung may partially offload to CPU on a small
# GPU (slower; the pipeline warns) — but it stays LOADED, which is the point.
# Matched twin: ollama-proxy-qwen-coder-32b.
# =============================================================================
export LLM_PROVIDER="ollama"
export LLM_ENDPOINT="http://10.3.1.226:80/api/chat"
export LLM_NUM_CTX="32768"
export LLM_MODELS_BY_ATTEMPT="qwen2.5:32b,qwen2.5:32b,qwen2.5:32b,qwen2.5:32b"
# OLLAMA_USERNAME / OLLAMA_PASSWORD from API-ollama-proxy (see run_project.sh).
