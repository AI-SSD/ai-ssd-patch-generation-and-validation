# =============================================================================
# Profile: openai-mix   (budget-smart: cheap minis -> flagship on retry)
# Strictly ascending. Attempts 1-3 use the 10M-tokens/day mini tier (most CVEs
# resolve here), and only persistent failures escalate to the 1M-tier flagship —
# so this spends the scarce flagship budget only where it's needed.
#
#   1: gpt-4.1-mini   (10M tier)
#   2: gpt-5-mini     (10M tier)
#   3: gpt-5.4-mini   (10M tier)
#   4: gpt-5.4        (1M tier — newest flagship)
# =============================================================================
export LLM_PROVIDER="openai"
export LLM_MODELS_BY_ATTEMPT="gpt-4.1-mini,gpt-5-mini,gpt-5.4-mini,gpt-4.1"
# OPENAI_API_KEY is exported by run_project.sh from the API-openai-key file.
