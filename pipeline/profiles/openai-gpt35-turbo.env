# =============================================================================
# Profile: openai-gpt35-turbo   (SINGLE-MODEL — gpt-3.5-turbo on every attempt)
# UNIFORM profile: the same model on all 4 attempts.
#
#   1-4: gpt-3.5-turbo  (= gpt-3.5-turbo-0125; LEGACY, knowledge cutoff Sep-2021)
#
# WHY THIS PROFILE: the "GPT-3 generation" stand-in. True GPT-3 (davinci-002)
# is a BASE completion model with no instruction following, so it cannot honour
# the SEARCH/REPLACE editing contract; gpt-3.5-turbo is the oldest usable chat
# model and shares gpt-4's Sep-2021 cutoff, giving a second pre-tcpdump-corpus
# data point at a fraction of the cost (~$1.30 per full 3-project pass).
#
# CAVEATS
#  * 16K context window — only ~1% of prompts do not fit (context_skip).
#  * Weak instruction following vs gpt-4/gpt-5: expect low patch-format
#    compliance; a low fix rate is a REAL result, not a harness fault.
#  * OpenAI shuts gpt-3.5-turbo down on 2026-10-23.
#
# UNRESTRICTED BY DESIGN: contamination gate disabled (all CVEs, pre and post
# cutoff); the post-cutoff subset is extracted post-hoc by publish date.
# =============================================================================
export LLM_PROVIDER="openai"
export LLM_MODELS_BY_ATTEMPT="gpt-3.5-turbo,gpt-3.5-turbo,gpt-3.5-turbo,gpt-3.5-turbo"
export SSD_CONTAMINATION_FILTER=0
# OPENAI_API_KEY is exported by run_project.sh from the API-openai-key file.
