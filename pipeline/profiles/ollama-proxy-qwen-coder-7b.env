# =============================================================================
# Profile: ollama-proxy-qwen-coder-7b   (SINGLE-MODEL — qwen2.5-coder:7b ×4)
# UNIFORM profile: the same coder model on all 4 attempts. No size ramp.
# See ollama-proxy-qwen-7b.env for the GPU-thrash rationale behind uniform
# profiles (one model loaded ⇒ parallel requests batch instead of evicting).
#
#   1-4: qwen2.5-coder:7b   (Qwen2.5-Coder, 7.6B, 32k ctx)
#
# Matched twin: ollama-proxy-qwen-7b (base qwen2.5 at the SAME size) — comparing
# the two isolates the effect of code-specialisation.
# =============================================================================
export LLM_PROVIDER="ollama"
export LLM_ENDPOINT="http://10.3.1.226:80/api/chat"
export LLM_NUM_CTX="32768"
export LLM_MODELS_BY_ATTEMPT="qwen2.5-coder:7b,qwen2.5-coder:7b,qwen2.5-coder:7b,qwen2.5-coder:7b"
# OLLAMA_USERNAME / OLLAMA_PASSWORD from API-ollama-proxy (see run_project.sh).
