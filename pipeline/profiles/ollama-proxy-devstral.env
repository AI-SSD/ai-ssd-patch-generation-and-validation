# =============================================================================
# Profile: ollama-proxy-devstral   (Mistral code family)
# Mistral ships only TWO open code-specialised models — Codestral (22B) and
# Devstral (24B) — so this isn't a size ladder, it's a 2-model Codestral-vs-
# Devstral head-to-head. Attempt 1 = codestral, attempt 2 = devstral; any further
# feedback-loop retries reuse the attempt-1 model (codestral).
#
#   1: codestral:22b        (Mistral code, 32k ctx)
#   2: devstral-32k:latest  (Mistral agentic coder, 128k ctx; the 32k build)
#
# Both present, both native ctx >= 32k -> LLM_NUM_CTX=32768 is safe. For a cross-
# family frontier comparison instead, see ollama-proxy-frontier-coder.
# =============================================================================
export LLM_PROVIDER="ollama"
export LLM_ENDPOINT="http://10.3.1.226:80/api/chat"
export LLM_NUM_CTX="32768"
export LLM_MODELS_BY_ATTEMPT="codestral:22b,devstral-32k:latest"
# OLLAMA_USERNAME / OLLAMA_PASSWORD from API-ollama-proxy (see run_project.sh).
