# =============================================================================
# Profile: ollama-proxy-qwen-7b   (SINGLE-MODEL — qwen2.5:7b on every attempt)
# UNIFORM profile: the same base/instruct model on all 4 attempts. No size ramp.
#
# WHY: the shared Ollama GPU cannot hold two model families at once. The ramped
# profiles made Phase 2 (attempt N model) and the Phase 1/3 negative filter
# (attempt-1 model) request DIFFERENT models — concurrently under the two-lane
# scheduler — so the server thrashed (evict/reload multi-GiB weights per
# request) and crashed. With one model everywhere, parallel requests batch
# safely on the single loaded model.
#
#   1-4: qwen2.5:7b   (Qwen2.5 base/instruct, 7.6B, 32k ctx)
#
# Feedback retries still get fresh context (errors, PoC output) — they just
# re-ask the SAME model. Matched twin: ollama-proxy-qwen-coder-7b (isolates the
# effect of code-specialisation at identical size).
# =============================================================================
export LLM_PROVIDER="ollama"
export LLM_ENDPOINT="http://10.3.1.226:80/api/chat"
export LLM_NUM_CTX="32768"
export LLM_MODELS_BY_ATTEMPT="qwen2.5:7b,qwen2.5:7b,qwen2.5:7b,qwen2.5:7b"
# OLLAMA_USERNAME / OLLAMA_PASSWORD from API-ollama-proxy (see run_project.sh).
