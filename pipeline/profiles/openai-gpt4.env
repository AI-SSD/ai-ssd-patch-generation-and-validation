# =============================================================================
# Profile: openai-gpt4   (SINGLE-MODEL — gpt-4 on every attempt)
# UNIFORM profile: the same model on all 4 attempts, matching the 2026-07-26
# campaign profiles so per-model attribution stays clean.
#
#   1-4: gpt-4  (= gpt-4-0613; LEGACY, knowledge cutoff Sep-2021)
#
# WHY THIS PROFILE: gpt-4 is the ONLY still-available capable model whose
# training cutoff predates the tcpdump corpus, so it is the only way to obtain
# post-cutoff (contamination-free) measurements on tcpdump-era CVEs.
#
# CAVEATS
#  * 8K TOTAL context window (prompt+output). The Phase-2 context guard
#    (llm.model_context_windows in config.yaml) skips prompts that do not fit
#    and clamps the output budget. Expect ~14% of tcpdump CVEs and ~2-6% of
#    glibc/OpenSSL CVEs to be skipped as context_skip — recorded, not silent.
#  * EXPENSIVE: $30/1M input, $60/1M output => roughly $75-110 for one full
#    3-project pass (about 100x gpt-5-mini). Watch the run before repeating it.
#  * OpenAI shuts gpt-4 down on 2026-10-23 — this profile stops working then.
#
# UNRESTRICTED BY DESIGN: the global contamination gate is disabled here so the
# run covers ALL CVEs (pre- and post-cutoff). The post-cutoff subset is then
# extracted post-hoc by publish date, exactly as for the 07-26 campaign.
# =============================================================================
export LLM_PROVIDER="openai"
export LLM_MODELS_BY_ATTEMPT="gpt-4,gpt-4,gpt-4,gpt-4"
export SSD_CONTAMINATION_FILTER=0
# OPENAI_API_KEY is exported by run_project.sh from the API-openai-key file.
