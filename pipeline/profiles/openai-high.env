# =============================================================================
# Profile: openai-high   (flagship OpenAI tier)
# Pure flagship ladder, strictly ascending by version across the 4 attempts.
# All four are on the 1M-tokens/day tier, so a full 3-project sweep can exhaust
# that budget — use this for the hard subset, or run fewer CVEs.
#
#   1: gpt-5      reasoning flagship
#   2: gpt-5.1
#   3: gpt-5.2
#   4: gpt-5.4    newest flagship
# =============================================================================
export LLM_PROVIDER="openai"
export LLM_MODELS_BY_ATTEMPT="gpt-5,gpt-5.1,gpt-5.2,gpt-5.4"
# OPENAI_API_KEY is exported by run_project.sh from the API-openai-key file.
