# =============================================================================
# Profile: openai-gpt54-mini   (SINGLE-MODEL — gpt-5.4-mini on every attempt)
# UNIFORM profile: the same model on all 4 attempts. No ramp — every feedback
# retry re-asks gpt-5.4-mini with fresh context, so per-model attribution is
# clean (one model per profile, matching the uniform Ollama profiles).
#
#   1-4: gpt-5.4-mini   (10M-tokens/day mini tier — newest mini)
# =============================================================================
export LLM_PROVIDER="openai"
export LLM_MODELS_BY_ATTEMPT="gpt-5.4-mini,gpt-5.4-mini,gpt-5.4-mini,gpt-5.4-mini"
# OPENAI_API_KEY is exported by run_project.sh from the API-openai-key file.
