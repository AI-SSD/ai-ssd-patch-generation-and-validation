# =============================================================================
# Profile: openai-codex   (code-specialized OpenAI models)
# The most task-relevant OpenAI family for patch generation. Ascending: starts
# on the cheap 10M-tier codex-mini models, escalates to the 1M-tier full codex
# flagships only on retry (budget-smart).
#
#   1: codex-mini-latest    (10M tier)
#   2: gpt-5.1-codex-mini   (10M tier)
#   3: gpt-5-codex          (1M tier)
#   4: gpt-5.1-codex        (1M tier — newest)
#
# CAVEAT: the full gpt-5*-codex models may require OpenAI's Responses API, while
# the pipeline calls chat.completions. If a model rejects chat.completions, that
# attempt fails gracefully (logged generation_failed) and the loop continues —
# it does NOT crash. Test on one CVE first; ask to add a Responses-API path if
# the full codex models don't answer over chat.completions.
# =============================================================================
export LLM_PROVIDER="openai"
export LLM_MODELS_BY_ATTEMPT="codex-mini-latest,gpt-5.1-codex-mini,gpt-5-codex,gpt-5.1-codex"
# OPENAI_API_KEY is exported by run_project.sh from the API-openai-key file.
