# =============================================================================
# Profile: openai-fast   (DEFAULT — cheap breadth)
# All four on the 10M-tokens/day mini/nano tier, ascending across the 4 attempts.
# Best for wide sweeps where you want many CVEs without touching the 1M flagship
# budget.
#
#   1: gpt-4.1-nano
#   2: gpt-4.1-mini
#   3: gpt-5-mini
#   4: gpt-5.4-mini
# =============================================================================
export LLM_PROVIDER="openai"
export LLM_MODELS_BY_ATTEMPT="gpt-4.1-nano,gpt-4.1-mini,gpt-5-mini,gpt-5.4-mini"
# OPENAI_API_KEY is exported by run_project.sh from the API-openai-key file.
