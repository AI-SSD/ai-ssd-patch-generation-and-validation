# =============================================================================
# Profile: ollama-proxy-qwen   (base/instruct Qwen2.5 family — size ladder)
# The matched twin of ollama-proxy-qwen-coder: the SAME family at the SAME sizes,
# the ONLY difference being that this uses the NORMAL (non-coder) qwen2.5 models.
# Comparing the two isolates exactly how much code-specialisation helps.
#
#   1: qwen2.5:1.5b
#   2: qwen2.5:7b
#   3: qwen2.5:14b
#   4: qwen2.5:32b
#
# All native context >= 32k, so LLM_NUM_CTX=32768 is safe. The 32B rung is heavy
# at 32k context (may partially offload to CPU on a small GPU; the pipeline warns).
# =============================================================================
export LLM_PROVIDER="ollama"
export LLM_ENDPOINT="http://10.3.1.226:80/api/chat"
export LLM_NUM_CTX="32768"
export LLM_MODELS_BY_ATTEMPT="qwen2.5:1.5b,qwen2.5:7b,qwen2.5:14b,qwen2.5:32b"
# OLLAMA_USERNAME / OLLAMA_PASSWORD from API-ollama-proxy (see run_project.sh).
