# =============================================================================
# Profile: ollama-proxy-frontier-coder   (was qwen-coder-xl)
# CROSS-FAMILY frontier: the strongest code model from each family, ascending in
# size. This is where Qwen vs DeepSeek vs Mistral(Devstral) get compared head to
# head at the high end — all code-specialized, all present, all native >= 32k ctx.
#
#   1: qwen2.5-coder:14b        (Qwen2.5,  14.8B,  32k ctx)
#   2: deepseek-coder-v2:latest (DeepSeek, 15.7B MoE, 128k ctx)
#   3: devstral-32k:latest      (Mistral,  23.6B,  128k ctx; the 32k build)
#   4: qwen3-coder:30b          (Qwen3 MoE, 30.5B, 256k ctx)
#
# Heavy VRAM at the top; may partially offload on a small GPU (pipeline warns).
# =============================================================================
export LLM_PROVIDER="ollama"
export LLM_ENDPOINT="http://10.3.1.226:80/api/chat"
export LLM_NUM_CTX="32768"
export LLM_MODELS_BY_ATTEMPT="qwen2.5-coder:14b,deepseek-coder-v2:latest,devstral-32k:latest,qwen3-coder:30b"
# OLLAMA_USERNAME / OLLAMA_PASSWORD from API-ollama-proxy (see run_project.sh).
