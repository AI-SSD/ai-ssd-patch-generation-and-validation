# =============================================================================
# Profile: ollama-proxy-qwen-coder
# Qwen2.5-Coder SIZE ladder on the authenticated proxy (10.3.1.226:80).
# Pure coder models, ascending in size — the matched twin of ollama-proxy-qwen
# (base qwen2.5 at the SAME sizes). The ONLY difference between the two profiles
# is "-coder", so comparing them isolates the effect of code-specialisation.
#
#   1: qwen2.5-coder:1.5b
#   2: qwen2.5-coder:7b
#   3: qwen2.5-coder:14b
#   4: qwen2.5-coder:32b
#
# All native context >= 32k, so LLM_NUM_CTX=32768 is safe (no RoPE extension).
# The 32B rung is heavy: at 32k context it may partially offload to CPU on a
# small GPU (slower) — the pipeline warns if so.
# =============================================================================
export LLM_PROVIDER="ollama"
export LLM_ENDPOINT="http://10.3.1.226:80/api/chat"
export LLM_NUM_CTX="32768"
export LLM_MODELS_BY_ATTEMPT="qwen2.5-coder:1.5b,qwen2.5-coder:7b,qwen2.5-coder:14b,qwen2.5-coder:32b"
# OLLAMA_USERNAME / OLLAMA_PASSWORD from API-ollama-proxy (see run_project.sh).
