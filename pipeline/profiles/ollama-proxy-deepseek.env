# =============================================================================
# Profile: ollama-proxy-deepseek   (DeepSeek code family — size ladder)
# DeepSeek-focused, mirroring ollama-proxy-qwen-coder. Pure code models,
# ascending in size across the 4 attempts.
#
#   1: deepseek-coder:1.3b       (v1)
#   2: deepseek-coder:6.7b       (v1)
#   3: deepseek-coder-v2:16b     (v2 MoE, 128k ctx)   [present]
#   4: deepseek-coder:33b        (v1)
#
# CONTEXT NOTE: the pipeline needs ~32k total ctx (whole-function regen can emit
# up to ~16k output tokens), so LLM_NUM_CTX=32768. DeepSeek-Coder **v1** rungs
# (1.3b/6.7b/33b) are only 16k-native, so Ollama RoPE-extends them to 32k —
# quality may degrade on the very longest prompts. Only the v2:16b rung handles
# 32k natively. (This context ceiling is itself a finding worth reporting.)
# =============================================================================
export LLM_PROVIDER="ollama"
export LLM_ENDPOINT="http://10.3.1.226:80/api/chat"
export LLM_NUM_CTX="32768"
export LLM_MODELS_BY_ATTEMPT="deepseek-coder:1.3b,deepseek-coder:6.7b,deepseek-coder-v2:latest,deepseek-coder:33b"
# OLLAMA_USERNAME / OLLAMA_PASSWORD from API-ollama-proxy (see run_project.sh).
